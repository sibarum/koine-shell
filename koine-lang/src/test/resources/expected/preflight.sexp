(# Everything before publishing: builds the stack, starts every application, checks the notices and versions, and / generates the installers without publishing them. /  / Nothing is uploaded, committed or pushed. Stops at the first failing step. It builds and starts the Windows / applications, so it is for Windows only.)
(script Preflight <Windows> (skipBuild = false, seconds = 8, buildOnly = false))
  (let dist (. Script directory))
  (let root (call (. Path parent) dist))
  (let logs (call (. Path join) dist 'logs'))
  (run (call (. Dir create) logs))
  (let configs [])
  (let suite (as (call (. Json read) (call (. Path join) dist 'installer-suite.json')) Suite))
  (for member (. suite members))
    (run (call (. configs add) (call (. Path full) (call (. Path join) dist (. member config)))))
  (if (not skipBuild))
    (step Build)
      (# The output is checked for FAILED as well as the exit status, so a failure can never pass as a build.)
      (let buildCmd (call (. Path join) dist 'build.cmd'))
      (let failed false)
      (for line (cmd {} [{buildCmd}]))
        (print line)
        (if (in 'FAILED' line))
          (= failed true)
      (if failed)
        (fail "The build printed FAILED; see logs/")
  (step Start)
    (let dead [])
    (for config configs)
      (let app (as (call (. Json read) config) App))
      (for binary (. (. app windows) binaries))
        (if (call (. (. binary source) endsWith) '.exe'))
          (let exe (call (. Path join) (call (. Path parent) config) (. binary source)))
          (if (not (call (. File exists) exe)))
            (run (call (. dead add) {}"{(. app id)}: no {exe}"))
          (else)
            (let log (call (. Path join) logs {}"start-{(. binary name)}.log"))
            (within (call (. Path parent) exe))
              (let process (call (. Process start) exe log))
              (run (call (. Clock sleep) seconds))
              (if (. process running))
                (print {}"  {(. binary name)} up")
                (run (. process stop))
              (else)
                (run (call (. dead add) {}"{(. binary name)} exited within {(. seconds text)}s; see logs/start-{(. binary name)}.log.err"))
    (if (not (. dead isEmpty)))
      (for problem dead)
        (run (call (. Console error) {}"  {problem}"))
      (fail "An application does not start")
  (# The Linux binaries are built in the Linux VM by build.sh, which writes logs/linux/BUILD.txt: the commit of every / checkout it built. They are fit to publish only while every one of those is still checked out.)
  (step Linux)
    (let linuxApps [])
    (for config configs)
      (let app (as (call (. Json read) config) App))
      (if (not (. (. app linux) isEmpty)))
        (run (call (. linuxApps add) (. app name)))
    (if (. linuxApps isEmpty))
      (print "  no application has a linux section")
    (else)
      (let problems (call linuxBuildProblems logs root configs))
      (while (not (. problems isEmpty)))
        (for problem problems)
          (run (call (. Console warn) {}"  {problem}"))
        (print "  Build them in the Linux VM, from a terminal on its desktop, in this folder: ./build.sh")
        (if (not (. Console interactive)))
          (fail "The Linux build is missing, or not of these sources")
        (run (call (. Console pause) "  Press Enter once it has finished, to check again (Ctrl+C stops)"))
        (= problems (call linuxBuildProblems logs root configs))
      (print {}"  built in the VM from these sources: {(call (. linuxApps join) ', ')}")
  (step Notices)
    (let python (. Python find))
    (if (. python isEmpty))
      (fail "No Python found (python, py, or anaconda3)")
    (let notices (call (. Path join) dist 'notices' 'notices.py'))
    (if (not (try? (cmd {} [{python}] [{notices}] [--check]))))
      (fail "The notices are out of date")
  (if buildOnly)
    (run (call (. Console success) "Built, started and checked."))
    (return)
  (step Versions)
    (for config configs)
      (let app (as (call (. Json read) config) App))
      (let manifest (call (. Path join) dist 'apps' (. app id) 'manifest.json'))
      (let latest (. String empty))
      (if (call (. File exists) manifest))
        (= latest (. (as (call (. Json read) manifest) Manifest) latest))
      (if (== latest (. app version)))
        (run (call (. Console warn) {}"  {(. app name)} {(. app version)} is already published; bump it in {config} if it changed"))
      (else if (. latest isEmpty))
        (print {}"  {(. app name)} {(. app version)} (published: none)")
      (else)
        (print {}"  {(. app name)} {(. app version)} (published: {latest})")
  (step Generate)
    (let deploy (call (. Script sibling) 'deploy'))
    (if (not (try? (cmd {} [{deploy}]))))
      (fail "deploy")
  (step Diff)
    (within dist)
      (try (cmd [git] [status] [--short]))
    (let site (call (. Path join) root 'sibarum.github.io'))
    (if (call (. File exists) (call (. Path join) site '.git')))
      (within site)
        (try (cmd [git] [status] [--short]))
    (run (call (. Console success) "Preflight passed. Look at git diff here (and in ../sibarum.github.io), then deploy -Publish."))
  (# What is wrong with the Linux build: missing, not of the commits checked out here, or without a binary an / application needs. Empty when it is fit to publish.)
  (def linuxBuildProblems (logs, root, configs))
    (let stamp (call (. Path join) logs 'linux' 'BUILD.txt'))
    (if (not (call (. File exists) stamp)))
      (return ["no Linux build: logs/linux/BUILD.txt is missing"])
    (let builtFrom {})
    (for line (call (. File lines) stamp))
      (if (not (call (. line matches) '^[[:space:]]*(#|$)')))
        (let words (. line words))
        (= (index builtFrom (index words 0)) (index words 1))
    (let problems [])
    (for repo (. builtFrom keys))
      (let checkout (call (. Path join) root repo))
      (let head (else (cmd {} [git] [-C] [{checkout}] [rev-parse] [HEAD]) 'nothing'))
      (if (!= head (index builtFrom repo)))
        (run (call (. problems add) {}"{repo}: the Linux build is of {(call (. (index builtFrom repo) take) 9)}, the checkout is at {(call (. head take) 9)}"))
    (for config configs)
      (let app (as (call (. Json read) config) App))
      (if (not (. (. app linux) isEmpty)))
        (let repo (call (. Path name) (call (. Path parent) config)))
        (if (not (call (. builtFrom has) repo)))
          (run (call (. problems add) {}"{repo}: not in the Linux build"))
        (for binary (. (. app linux) binaries))
          (if (not (call (. File exists) (call (. Path join) (call (. Path parent) config) (. binary source)))))
            (run (call (. problems add) {}"{(. app id)}: no {(. binary source)}"))
    (return problems)
  (# The fields of the JSON files this script reads; the files may hold more.)
  (record Suite)
    (members [Member])
  (record Member)
    (config String)
  (record App)
    (id String)
    (name String)
    (version String)
    (windows Platform)
    (linux Platform?)
  (record Platform)
    (binaries [Binary])
  (record Binary)
    (name String)
    (source String)
  (record Manifest)
    (latest String)
